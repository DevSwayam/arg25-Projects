{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd unwallet-bond-credit && npm install"
  },
  "deploy": {
    "startCommand": "cd unwallet-bond-credit && npm start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

